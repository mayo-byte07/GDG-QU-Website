# Copy to the repository root as .env for local admin API development.
# Never add a SUPABASE_SECRET_KEY to a VITE_* variable or commit the .env file.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json